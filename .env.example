# Database Connection String
# Local SQLite fallback: sqlite:///./cti_platform.db
# Docker PostgreSQL: postgresql://cti_user:cti_password@db:5432/cti_db
DATABASE_URL=sqlite:///./cti_platform.db

# CTI Third-party API Keys (Get free tier keys from Virustotal & AbuseIPDB)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# App Server Port
PORT=8000
